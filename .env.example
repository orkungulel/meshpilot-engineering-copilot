# Copy to .env (gitignored) and fill in locally. Never commit .env.
# Docker: pass it at run time with `docker run --env-file .env ...`.

# Anthropic API key. Only answer generation, the agent and the eval judge need it;
# downloading, indexing, retrieval evaluation and the tests do not.
ANTHROPIC_API_KEY=

# Model that writes answers and runs the agent.
RAG_MODEL=claude-sonnet-5-5

# Model that judges answers in the evaluation (kept different from RAG_MODEL
# so a model never grades its own answers).
RAG_JUDGE_MODEL=claude-opus-5-5

# Index configuration the API serves (R1, R2 or R3; see rag/config.py).
RAG_INDEX=R1

# MeshPilot chat provider: claude or perplexity. If unset, the provider whose key
# is set is used (Claude first). Put real keys only in .env, never in this file.
MESHPILOT_CHAT_PROVIDER=
# Perplexity Agent API key and model, for MESHPILOT_CHAT_PROVIDER=perplexity.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=openai/gpt-6-luna
